# Installer screen. Unlike the appliance's layout there is one window and no
# output or touch mapping: the operator may have the touchscreen on either
# HDMI port, and a mapping to an absent output would leave touch dead.
# --disable-gpu: with no keyboard, a GPU fault that left the page black would
# strand the operator; software rendering is ample for one static page.
output * bg #0e1116 solid_color
default_border none
seat * hide_cursor 8000
for_window [app_id="^(chromium|chrome-)"] fullscreen enable
exec chromium --ozone-platform=wayland --kiosk --no-first-run --noerrdialogs \
  --disable-session-crashed-bubble --disable-features=Translate --touch-events=enabled --disable-gpu \
  --user-data-dir=/home/shack/.config/openhamshack-installer --app=http://127.0.0.1:8080/
